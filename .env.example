# Copy this file to .env for local Windows development.
# Never commit real credentials.

NODE_ENV=development

# API server
API_PORT=8080
PORT=8080
BASE_PATH=/

# Vite dashboard
DASHBOARD_PORT=8081

# PostgreSQL database used by drizzle/node-postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maslive

# Optional executable paths for configured security tools.
# Use full Windows paths when a tool is not already in PATH.
MSFCONSOLE_PATH=msfconsole
NMAP_PATH=nmap
NIKTO_PATH=nikto
